# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# ------------------------------------------------------------------
# Runtime state and personal data.
#
# These contain message summaries, sender addresses, subject lines,
# your resume, and generated drafts. None of it belongs in version
# control. Verify with `git status` before your first commit.
# ------------------------------------------------------------------
state.db
state.db-journal
state.db-wal
# Any extension and any case: resume.txt, resume.JSON, resume.pdf.
# git matches case-sensitively even on a case-insensitive filesystem, so
# a narrow `resume.txt` rule silently fails to cover `resume.JSON`.
resume*
Resume*
RESUME*
boards.json
briefs/
drafts/
*.log

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp
